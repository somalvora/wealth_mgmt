# Copy to .env (git-ignored) and fill in. Hosted models get synthetic data only (design §11).
GEMINI_API_KEY=                     # free key from aistudio.google.com (any personal Google account)
# GROQ_API_KEY=                     # console.groq.com (sign-up may require an organization invite)
# HH_CHAT_MODEL=gemini:gemini-2.5-flash
# HH_REQUESTS_PER_MINUTE=10         # shared by all models of one provider in a run; lower it if you see 429s
# HH_LLM_CACHE=.cache/llm.sqlite    # "off" to disable; delete the file to re-sample answers
